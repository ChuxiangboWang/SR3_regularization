{
    "name": "Mri_vgg100_withpretrain_train",
    "phase": "train", // train | val | pretrain
    
    "pretrain": {
        "script": "pretrain_CNN/train.py",  
        "lr": 32,
        "hr": 128,
        "hr_dir": "./dataset/MRI_Test_32_128/hr_128",
        "lr_dir": "./dataset/MRI_Test_32_128/lr_32",  
        "batch_size": 16,
        "batch_size_eval": 10,  // Increase with large data set
        "learning_rate": 1.0,
        "epochs": 1000, // Increase with large data set
        "num_workers": 4,
        "extra_args": ["-c", "config/celebahq6.json"],
        "ckpt_path": null, // "pretrain_CNN/cnn_weights.pth"
        "TVrelu": 0
      },
    
    "gpu_ids": [0],
    "path": { //set the path
        "log": "logs",
        "tb_logger": "tb_logger",
        "results": "results",
        "checkpoint": "checkpoint",
        "resume_state": null
        // "experiments/tv0_pretrain_251206_143111/checkpoint/I2000000_E1405"
    },
    "datasets": {
        "train": {
            "name": "celebahq",
            "mode": "HR", // whether need LR img
            "dataroot": "dataset/MRI_Train_32_128",//output
            "datatype": "img", //lmdb or img, path of img files
            "l_resolution": 32, // low resolution need to super_resolution
            "r_resolution": 128, // high resolution
            "batch_size": 2,
            "num_workers": 4,
            "use_shuffle": true,
            "data_len": -1, // -1 represents all data used in train
            "cnn_sr": true // whether use CNN processed LR
        },
        "val": {
            "name": "celebahq",
            "mode": "LRHR",
            "dataroot": "dataset/MRI_Test_32_128",
            "datatype": "img", //lmdb or img, path of img files
            "l_resolution": 32,
            "r_resolution": 128,
            "data_len": 100, // data length of validation in both train and val phase
            "n_run":10, // if phase == 'train': n_run will be override to one; If phase == 'val': n_run = your setting. 
            "cnn_sr": true // whether use CNN processed LR as input
        
        }
    },
    "model": {
        "which_model_G": "sr3", // use the ddpm or sr3 network structure
        "finetune_norm": false,
        "unet": {
            "in_channel": 2,
            "out_channel": 1,
            "inner_channel": 64,
            "channel_multiplier": [
                1,
                2,
                4,
                8,
                8
            ],
            "attn_res": [
                16
            ],
            "res_blocks": 2,
            "dropout": 0.2,
            "final_activation": "swish", // default swish. Can be chosen from, swish,relu,and leakyrelu
            "leaky_alpha": 0.2 // alpha for the leaky relu
        },
        "beta_schedule": { // use munual beta_schedule for acceleration
            "train": {
                "schedule": "linear",
                "n_timestep": 2000,
                "linear_start": 1e-6,
                "linear_end": 1e-2
            },
            "val": {
                "schedule": "linear",
                "n_timestep": 2000,
                "linear_start": 1e-6,
                "linear_end": 1e-2
            }
        },
        "diffusion": {
            "image_size": 128,
            "channels": 1, //sample channel
            "conditional": true // unconditional generation or unconditional generation(super_resolution)
        },
        "loss": {
            "type": "l1", // l1 or l2
            "TV1_weight": 0.0,
            "TV2_weight": 0.0,
            "TVF_weight": 0.0,
            "TVF_alpha": 0.0,//default is 1.6
            "wavelet_l1_weight": 0.0, //10000.0,
            "wavelet_type": "haar" //default is "haar". Other options includes "db", "sym", "coif"  (https://pywavelets.readthedocs.io/en/latest/ref/wavelets.html)
        },
  
        "vgg": {
           "weight": 100,            // Set to 0 to turn off VGG
           "start_step": 5000,       // Starting iteration step of VGG
           "vis_freq": 200000,         // VGG_feature_plot_every# iteration
           "vis_num_channels": 36    // VGG_feature_plot_how many channels
        }
    },
    "train": {
        "n_iter": 2000000,
        "val_freq": 1e05,
        "save_checkpoint_freq": 1e5,
        "print_freq": 200,
        "optimizer": {
            "type": "adam",
            "lr": 1e-4
        },
        "ema_scheduler": { // not used now
            "step_start_ema": 5000,
            "update_ema_every": 1,
            "ema_decay": 0.9999
        }
    },
    "wandb": {
        "project": "sr_ffhq"
    }
}
